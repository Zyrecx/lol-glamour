<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Glamour.Core\Glamour.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Panel\Assets\hide-augments.gray" LogicalName="Glamour.Host.Panel.Assets.hide-augments.gray" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WebDir>$(MSBuildProjectDirectory)\..\..\web</WebDir>
  </PropertyGroup>

  <!-- The UI is a Svelte app in /web that builds into wwwroot. This builds it on a fresh clone only; day to day run `npm run build` (or `npm run watch`) in /web. -->
  <Target Name="BuildWebUi" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\index.html') And Exists('$(WebDir)\package.json')">
    <Exec Command="npm ci" WorkingDirectory="$(WebDir)" Condition="!Exists('$(WebDir)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(WebDir)" />
  </Target>

</Project>
